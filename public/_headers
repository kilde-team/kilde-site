/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'none'; script-src 'self' https://www.googletagmanager.com https://static.cloudflareinsights.com; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://cloudflareinsights.com; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# _headers rules are ADDITIVE: every matching rule contributes its headers, so
# a broad /assets/* rule plus a narrower one would emit two Cache-Control values
# for the same file. The static assets are therefore listed individually.
/assets/styles.css
  Cache-Control: public, max-age=86400, must-revalidate

/assets/og.png
  Cache-Control: public, max-age=86400, must-revalidate

/assets/favicon.svg
  Cache-Control: public, max-age=86400, must-revalidate

# The analytics config has no content hash in its filename, so a long cache
# would mean a change to the tracking setup (or switching it off) takes a day
# to reach returning visitors. Keep it short.
/assets/analytics.js
  Cache-Control: public, max-age=300, must-revalidate
